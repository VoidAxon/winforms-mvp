<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Kibinago.Samples</RootNamespace>
    <AssemblyName>Kibinago.Samples</AssemblyName>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kibinago\Kibinago.csproj" />
    <ProjectReference Include="..\..\src\Kibinago.Analyzers\Kibinago.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <!-- Syntax-highlighted sources in the main window's コード tab (MIT; sample only, not a framework dependency). -->
    <PackageReference Include="Scintilla5.NET" Version="7.1.1" />
  </ItemGroup>

  <!-- The sample's own sources, shown in the main window's コード tab (Shell/SampleSources.cs). -->
  <ItemGroup>
    <EmbeddedResource Include="**\*.cs" Exclude="bin\**;obj\**" LogicalName="Source/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" />
    <!-- A few presenter tests, for the テスト・ツール category. -->
    <EmbeddedResource Include="..\..\tests\Kibinago.Samples.Tests\Presenters\ToDoDemoPresenterTests.cs;..\..\tests\Kibinago.Samples.Tests\Mocks\MockToDoView.cs;..\..\tests\Kibinago.Samples.Tests\Samples\*.cs"
                      LogicalName="Source/Tests/%(Filename)%(Extension)" WithCulture="false" Link="Tests\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="obj\**" />
    <EmbeddedResource Remove="obj\**" />
    <None Remove="obj\**" />
  </ItemGroup>

</Project>
