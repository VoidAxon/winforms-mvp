<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>MultiProjectDemo.OrderModule</RootNamespace>
    <AssemblyName>MultiProjectDemo.OrderModule</AssemblyName>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kibinago\Kibinago.csproj" />
    <ProjectReference Include="..\..\src\Kibinago.DependencyInjection\Kibinago.DependencyInjection.csproj" />
    <ProjectReference Include="..\..\src\Kibinago.Analyzers\Kibinago.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="obj\**" />
    <EmbeddedResource Remove="obj\**" />
    <None Remove="obj\**" />
  </ItemGroup>

</Project>
