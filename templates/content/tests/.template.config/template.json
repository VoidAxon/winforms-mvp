{
  "$schema": "http://json.schemastore.org/template",
  "author": "VoidAxon",
  "classifications": [ "Desktop", "WinForms", "MVP", "Test", "xUnit" ],
  "identity": "Kibinago.Templates.Tests",
  "name": "Kibinago Presenter Tests",
  "description": "An xUnit project for presenter tests: references Kibinago.Testing (PresenterTestHost, CapturingActionBinder, service fakes) and contains an example test.",
  "shortName": "kibinago-tests",
  "sourceName": "MvpApp.Tests",
  "preferNameDirectory": true,
  "tags": { "language": "C#", "type": "project" },
  "symbols": {
    "Framework": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        { "choice": "net10.0-windows", "description": ".NET 10 (Windows)" },
        { "choice": "net472", "description": ".NET Framework 4.7.2" }
      ],
      "defaultValue": "net10.0-windows",
      "replaces": "TARGET_FRAMEWORK",
      "description": "Target framework (use the application's)."
    },
    "KibinagoVersion": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "__KIBINAGO_VERSION__",
      "replaces": "MVP_PACKAGE_VERSION",
      "description": "Kibinago package version (default: the version these templates were released with)."
    },
    "AppProject": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "replaces": "APP_PROJECT_PATH",
      "description": "Path to the application project under test, relative to the new test project (e.g. ../MyApp/MyApp.csproj)."
    },
    "HasAppProject": {
      "type": "computed",
      "value": "(AppProject != \"\")"
    }
  },
  "primaryOutputs": [ { "path": "MvpApp.Tests.csproj" } ]
}
