<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>TARGET_FRAMEWORK</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets dotnet build / restore run on Linux and macOS too (no effect on Windows). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MyMvpApp</RootNamespace>
  </PropertyGroup>

  <!-- .NET Framework needs the WinForms assemblies referenced explicitly. -->
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Brings Kibinago.Core and the MVP design-rule analyzers with it. -->
    <PackageReference Include="Kibinago" Version="MVP_PACKAGE_VERSION" />
  </ItemGroup>

</Project>
