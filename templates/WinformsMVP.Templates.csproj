<Project Sdk="Microsoft.NET.Sdk">

  <!--
    dotnet new templates for WinformsMVP:
      winformsmvp        - WinForms application with a main window
      mvp-window         - View interface + actions + presenter + Form
      mvp-control        - View interface + presenter + UserControl
      winformsmvp-tests  - xUnit presenter-test project
    Install: dotnet new install WinformsMVP.Templates
    The content folders are template sources, not part of this build; tests/templates/verify-templates.sh
    instantiates and builds every template.
  -->
  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>WinformsMVP.Templates</PackageId>
    <Description>dotnet new templates for WinformsMVP: an application, a window (View interface + actions + presenter + Form), a UserControl, and a presenter test project.</Description>
    <PackageTags>mvp;winforms;templates;dotnet-new</PackageTags>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <!-- No lib/ folder in a template package. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="content\**\*" Exclude="content\**\bin\**;content\**\obj\**" />
    <Compile Remove="**\*" />
    <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
