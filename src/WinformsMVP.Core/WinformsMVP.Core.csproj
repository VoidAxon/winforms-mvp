<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Platform-neutral half of the framework: presenters, the ViewAction dispatcher,
    EventAggregator, ChangeTracker, validation, logging and the service interfaces.
    It has no System.Windows.Forms reference, so presenter code that compiles against
    this assembly cannot touch WinForms types — the MVP layering is enforced by the
    compiler, and presenter tests can run on any .NET runtime.

    The WinForms implementation (WindowNavigator, ViewActionBinder, dialogs, toasts)
    lives in the WinformsMVP package, which depends on this one.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>WinformsMVP</RootNamespace>
    <AssemblyName>WinformsMVP.Core</AssemblyName>
    <LangVersion>latest</LangVersion>

    <!-- Shippable: opt in to packing (Directory.Build.props defaults to false). -->
    <IsPackable>true</IsPackable>
    <PackageId>WinformsMVP.Core</PackageId>
    <Description>Platform-neutral core of the WinformsMVP framework (netstandard2.0): presenter base classes, ViewAction dispatcher, EventAggregator, ChangeTracker, validation, logging and service abstractions. Bundles the MVP design-rule analyzers. Reference WinformsMVP for the WinForms implementation.</Description>
    <PackageTags>mvp;winforms;model-view-presenter;desktop;analyzers</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- DataAnnotations (validation attributes, IValidatableObject) is not part of netstandard2.0. -->
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WinformsMVP" />
    <InternalsVisibleTo Include="WinformsMVP.DependencyInjection" />
    <InternalsVisibleTo Include="WinformsMVP.Samples.Tests" />
  </ItemGroup>

  <!-- Pack the repo-root README into the package (referenced by PackageReadmeFile in Directory.Build.props). -->
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!--
    Bundle the MVP Roslyn analyzers into this package. Analyzers flow transitively, so
    consumers of WinformsMVP (which depends on this package) get the MVP design-rule
    checks too, with no extra package to install.

    We use an MSBuild Target (not a ProjectReference) to trigger the analyzer build.
    A ProjectReference would make the analyzer a runtime dependency of the package.
    The analyzer runs inside the C# compiler — TFM compatibility is irrelevant here.

    The analyzer ships under analyzers/dotnet/cs (no TFM segment) so the single
    netstandard2.0 build applies to every consumer TFM.
  -->
  <Target Name="BuildMVPAnalyzers"
          BeforeTargets="Build;Pack"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\WinformsMVP.Analyzers\WinformsMVP.Analyzers.csproj"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="TargetFramework"
             Targets="Build" />
  </Target>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\WinformsMVP.Analyzers\bin\$(Configuration)\netstandard2.0\WinformsMVP.Analyzers.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>

</Project>
